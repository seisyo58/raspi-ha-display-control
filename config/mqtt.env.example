# Copy to /etc/raspi-ha-display-control/mqtt.env and set permissions to 600.
MQTT_HOST=mqtt.example.local
MQTT_PORT=1883
MQTT_USERNAME=raspi3-display
MQTT_PASSWORD=replace-me

# Set MQTT_TLS=true and optionally provide a CA bundle for brokers outside the LAN.
MQTT_TLS=false
# MQTT_TLS_CA_CERT=/etc/ssl/certs/ca-certificates.crt

MQTT_CLIENT_ID=raspi3-display-mqtt
MQTT_KEEPALIVE=60
# Set the connector name for a fixed target, or use auto when exactly one
# physical display output is present. The current Pi uses HDMI-A-1.
DISPLAY_OUTPUT=HDMI-A-1
DISPLAY_STATUS_INTERVAL=300
DISPLAY_CONTROL_TIMEOUT=50
